<section>
  <h2>Companies</h2>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Role</th>
        <th>Min CGPA</th>
        <th>Location</th>
        <th>Package</th>
        <th>Openings</th>
        <th>Applied</th>
      </tr>
    </thead>
    <tbody>
      <% companies.forEach(function(c) { %>
        <tr>
          <td><%= c.name %></td>
          <td><%= c.role %></td>
          <td><%= c.minCgpa %></td>
          <td><%= c.location %></td>
          <td><%= c.package %></td>
          <td><%= c.openings %></td>
          <td><%= c.appliedCount %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
